# Optional API override. Public Vercel builds set this explicitly to the Render
# API. Leave it unset for an Edge production build so requests stay same-origin
# on the local FastAPI process. Vite development defaults to localhost:8000.
# VITE_API_BASE_URL=https://seawatch-bgsi.onrender.com

# Offline demo mode. When "true", the dashboard reads bundled demo fixtures
# instead of the backend, so a presentation never fails if the API is down.
# Demo data is clearly labeled in the UI and is not live data.
VITE_DEMO_MODE=false
