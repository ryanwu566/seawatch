# Base URL of the SeaWatch FastAPI backend.
# Copy this file to `.env` and adjust as needed.
VITE_API_BASE_URL=http://localhost:8000

# Offline demo mode. When "true", the dashboard reads bundled demo fixtures
# instead of the backend, so a presentation never fails if the API is down.
# Demo data is clearly labeled in the UI and is not live data.
VITE_DEMO_MODE=false
