# SeaWatch historical runtime
# Full SSD root; drive letter may change between machines.
SEAWATCH_DATA_ROOT=D:/SeaWatch

# Optional explicit compact runtime override.
# If omitted, backend resolves:
# <SEAWATCH_DATA_ROOT>/historical_2026/runtime/SeaWatch_Runtime_Taiwan_2026_v2
# SEAWATCH_HISTORICAL_RUNTIME=E:/SeaWatch/historical_2026/runtime/SeaWatch_Runtime_Taiwan_2026_v2
